// Woodivo Social Publisher - Prisma Schema (MongoDB)
// Stores publishing jobs, structured logs, retry history, AI responses,
// Meta Graph API responses, and final publishing history.
//
// MongoDB has no native foreign keys, so relations are emulated by Prisma
// itself (relationMode = "prisma"). Each model below becomes its own
// collection in whatever database DATABASE_URL points to.

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x", "debian-openssl-1.1.x"]
}

datasource db {
  provider     = "mongodb"
  url          = env("DATABASE_URL")
  relationMode = "prisma"
}

enum PublishJobStatus {
  PENDING
  PROCESSING
  VALIDATING
  AI_GENERATING
  MEDIA_PROCESSING
  PUBLISHING
  COMPLETED
  FAILED
}

enum PublishStage {
  VALIDATION
  AI_GENERATION
  MEDIA_PROCESSING
  PUBLISHING
  ARCHIVING
}

enum SocialPlatform {
  FACEBOOK
  INSTAGRAM
}

enum LogLevel {
  DEBUG
  INFO
  WARN
  ERROR
}

// What kind of Woodivo content a post originated from - lets the scheduler
// give each content type its own turn per run (see SchedulerService) instead
// of one type's backlog starving another's. OTHER covers posts submitted
// without this context (e.g. dropped directly into pending/ for local testing).
// CUSTOM covers posts built directly in Woodivo's CMS that aren't tied to any
// Product/Blog record at all.
enum PostSourceType {
  PRODUCT
  BLOG
  CUSTOM
  OTHER
}

enum AutoReplyTrigger {
  COMMENT
  DM
}

enum AutoReplyPlatform {
  FACEBOOK
  INSTAGRAM
  BOTH
}

model PublishJob {
  id     String           @id @default(auto()) @map("_id") @db.ObjectId
  // Human-readable label for logs/emails/CMS display - no longer a real
  // filesystem path. Media lives in Cloudinary from the moment it's
  // submitted, so nothing about this job depends on local disk surviving
  // between the submission and the scheduled processing slot.
  reference String
  status    PublishJobStatus @default(PENDING)
  seoRawText String
  seoParsed  Json?
  mediaType         String?
  // One or more Cloudinary URLs/publicIds - a single item is an ordinary post,
  // more than one is published as a Facebook/Instagram carousel (see
  // FacebookService/InstagramService). Order is preserved end-to-end.
  mediaUrls               String[]
  mediaPublicIds          String[]
  processedMediaUrls      String[]
  processedMediaPublicIds String[]
  generatedContent  Json?
  failureReason     String?
  failedStage       PublishStage?
  sourceType        PostSourceType @default(OTHER)
  // Originating Woodivo product/blog id and display title, passed through by
  // the caller at submission time (see ingest DTO) - lets Woodivo's CMS show
  // "what was posted" without this service needing to know about products/blogs.
  sourceId          String?
  sourceTitle       String?
  // "Post Now" - wins the pick for its sourceType bucket over non-urgent
  // PENDING jobs regardless of submission order (see SchedulerService).
  urgent            Boolean        @default(false)
  // "Post as Reel" - set from the CMS Custom Posts flow only. When true, the
  // Facebook branch of PublishingProcessor uses the dedicated /video_reels
  // flow instead of a plain Page video post; Instagram already Reels-ifies
  // any single video regardless of this flag.
  isReel            Boolean        @default(false)
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt
  startedAt         DateTime?
  completedAt       DateTime?
  failedAt          DateTime?

  logs              PostLog[]
  retries           RetryHistory[]
  aiResponses       AiResponse[]
  metaResponses     MetaResponse[]
  publishingHistory PublishingHistory[]

  @@index([status])
  @@index([createdAt])
  @@index([sourceType])
  @@map("publish_jobs")
}

model PostLog {
  id        String     @id @default(auto()) @map("_id") @db.ObjectId
  jobId     String     @db.ObjectId
  job       PublishJob @relation(fields: [jobId], references: [id], onDelete: Cascade)
  level     LogLevel
  message   String
  context   Json?
  createdAt DateTime   @default(now())

  @@index([jobId])
  @@map("post_logs")
}

model RetryHistory {
  id          String       @id @default(auto()) @map("_id") @db.ObjectId
  jobId       String       @db.ObjectId
  job         PublishJob   @relation(fields: [jobId], references: [id], onDelete: Cascade)
  stage       PublishStage
  attempt     Int
  maxAttempts Int
  error       String
  willRetry   Boolean
  createdAt   DateTime     @default(now())

  @@index([jobId])
  @@map("retry_history")
}

model AiResponse {
  id             String     @id @default(auto()) @map("_id") @db.ObjectId
  jobId          String     @db.ObjectId
  job            PublishJob @relation(fields: [jobId], references: [id], onDelete: Cascade)
  provider       String
  model          String?
  prompt         String
  rawResponse    String
  parsedResponse Json?
  isValid        Boolean    @default(false)
  attempt        Int        @default(1)
  createdAt      DateTime   @default(now())

  @@index([jobId])
  @@map("ai_responses")
}

model MetaResponse {
  id              String         @id @default(auto()) @map("_id") @db.ObjectId
  jobId           String         @db.ObjectId
  job             PublishJob     @relation(fields: [jobId], references: [id], onDelete: Cascade)
  platform        SocialPlatform
  endpoint        String
  requestPayload  Json
  responsePayload Json
  statusCode      Int?
  success         Boolean
  externalId      String?
  createdAt       DateTime       @default(now())

  @@index([jobId])
  @@map("meta_responses")
}

model PublishingHistory {
  id          String         @id @default(auto()) @map("_id") @db.ObjectId
  jobId       String         @db.ObjectId
  job         PublishJob     @relation(fields: [jobId], references: [id], onDelete: Cascade)
  platform    SocialPlatform
  externalId  String
  permalink   String?
  caption     String
  publishedAt DateTime       @default(now())

  @@index([jobId])
  @@map("publishing_history")
}

// Keyword-triggered engagement automation rules, managed from Woodivo's CMS.
// Evaluated in ascending `priority` order - the first active rule whose
// keywords match wins (mirrors the scheduler's "one pick per bucket" style).
model AutoReplyRule {
  id           String            @id @default(auto()) @map("_id") @db.ObjectId
  platform     AutoReplyPlatform @default(BOTH)
  trigger      AutoReplyTrigger
  keywords     String[]
  active       Boolean           @default(true)
  priority     Int               @default(0)
  // Public reply text - only used when trigger = COMMENT.
  replyComment String?
  // DM text - sent when trigger = COMMENT (comment-to-DM funnel) or used to
  // reply in-thread when trigger = DM.
  replyDm      String?
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  @@index([trigger, active])
  @@map("auto_reply_rules")
}

// Audit trail of every inbound comment/message event received via the Meta
// webhook, and what (if anything) the auto-reply engine did about it.
model InboundEventLog {
  id            String         @id @default(auto()) @map("_id") @db.ObjectId
  platform      SocialPlatform
  eventType     String
  externalId    String
  senderId      String
  text          String
  matchedRuleId String?
  actionTaken   String?
  rawPayload    Json
  createdAt     DateTime       @default(now())

  @@index([platform, eventType])
  @@map("inbound_event_log")
}
