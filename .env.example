# ============================================================
# Woodivo Social Publisher - Environment Configuration
# Copy this file to .env and fill in real values. Never commit .env.
# ============================================================

# --- Application ---
NODE_ENV=development
PORT=3000
APP_NAME=woodivo-social-publisher

# --- Scheduler ---
# Standard cron expression, evaluated by @nestjs/schedule (seconds field optional).
# Example below fires 4x/day at 10:00, 13:00, 17:00, 20:00 in SCHEDULER_TIMEZONE.
SCHEDULER_CRON_EXPRESSION=0 10,13,17,20 * * *
# Set to false to disable the scheduler entirely (e.g. for manual/testing runs).
SCHEDULER_ENABLED=true
# IANA timezone name the cron expression above is evaluated in (important once deployed -
# server clocks are typically UTC, not your local time).
SCHEDULER_TIMEZONE=Asia/Kolkata

# --- Retry / Backoff (applies to BullMQ queues) ---
QUEUE_MAX_RETRIES=3
QUEUE_RETRY_BACKOFF_MS=5000

# --- MongoDB / Prisma ---
# Point this at whatever database you want the app's collections created in
# (publish_jobs, post_logs, retry_history, ai_responses, meta_responses, publishing_history).
# It can be the same database that already has other collections (e.g. "test") - Prisma only
# adds its own collections, it never touches unrelated ones.
DATABASE_URL=mongodb+srv://<user>:<password>@<cluster-host>/<database-name>?retryWrites=true&w=majority

# --- Redis / BullMQ ---
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_TLS=false

# --- Meta Graph API (Facebook Page + Instagram Business Account) ---
META_GRAPH_API_BASE_URL=https://graph.facebook.com
META_GRAPH_API_VERSION=v21.0
META_APP_ID=
META_APP_SECRET=
META_PAGE_ID=
META_PAGE_ACCESS_TOKEN=
META_IG_BUSINESS_ACCOUNT_ID=
META_REQUEST_TIMEOUT_MS=30000
# A secret value you invent yourself and paste into the Meta App Dashboard's
# Webhooks setup screen (Products -> Webhooks -> Page/Instagram -> Verify Token).
# Meta echoes this back on the GET verification handshake so we can confirm
# the subscription request actually came from your app's dashboard.
META_WEBHOOK_VERIFY_TOKEN=

# --- Cloudinary (media storage - original + processed media, public URLs for Instagram) ---
# Media is stored here rather than local disk, so a submitted post's media
# survives container restarts/redeploys between submission and its scheduled
# processing slot. Reuse the same account/credentials as Woodivo's backend
# if you want everything in one place.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- Groq AI Provider (groq.com - fast inference, OpenAI-compatible API) ---
GROQ_API_BASE_URL=https://api.groq.com/openai/v1
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_REQUEST_TIMEOUT_MS=45000
GROQ_MAX_JSON_RETRIES=3

# --- Media Processing ---
IMAGE_MAX_WIDTH=1440
IMAGE_MAX_HEIGHT=1800
IMAGE_JPEG_QUALITY=82
IMAGE_MAX_SIZE_BYTES=8388608
VIDEO_MAX_DURATION_SEC=180
VIDEO_MAX_SIZE_BYTES=104857600
VIDEO_TARGET_BITRATE_KBPS=3500
FFMPEG_PATH=
FFPROBE_PATH=
MEDIA_PROCESSING_TIMEOUT_MS=300000

# --- Mail (failure notifications) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=alerts@woodivo.local
MAIL_TO=

# --- Logging ---
LOG_LEVEL=info
LOG_PRETTY=true

# --- Ingest API (Woodivo backend -> this app, when deployed as separate services) ---
# POST /posts with header "x-api-key: <this value>", multipart fields:
#   media = the image/video file
#   seo   = raw seo.txt-formatted text
# Generate a real secret with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
INGEST_API_KEY=
INGEST_MAX_UPLOAD_BYTES=157286400
